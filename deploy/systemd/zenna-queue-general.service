; Systemd alternative to deploy/supervisor/zenna-queue-general.conf.
; Install: sudo cp deploy/systemd/*.service /etc/systemd/system/
;          sudo systemctl daemon-reload
;          sudo systemctl enable --now zenna-queue-general
; Adjust User/Group, WorkingDirectory, and the php binary path for your server.

[Unit]
Description=Zenna Craft Queue Worker (Transactional + Bulk)
After=network.target

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/var/www/zenna-craft
ExecStart=/usr/bin/php artisan queue:work database --queue=transactional,bulk --sleep=3 --tries=3 --max-time=3600

[Install]
WantedBy=multi-user.target
